  },
  "homepage": "https://github.com/victorsalmon/agentic-bugfix-plugin",
  "bugs": {
    "url": "https://github.com/victorsalmon/agentic-bugfix-plugin/issues"
  },
  "keywords": [
    "bugfix",
    "testing",
    "quality",
    "regression",
    "root-cause",
    "methodology",
    "4c",
    "agent-skills",
    "concern-cause-countermeasure-check"
