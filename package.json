  "description": "A disciplined, four-gate bug-fixing methodology for coding agents — Concern → Cause → Countermeasure → Check.",
  "license": "MIT",
  "author": {
    "name": "Victor Salmon",
    "url": "https://github.com/victorsalmon"
  },
  "repository": {
    "type": "git",
